{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DevOpsAdapterResult.v1",
  "type": "object",
  "required": [
    "schema_version",
    "operation_key",
    "state",
    "log_reference",
    "log_digest",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "pending"
        },
        {
          "type": "string",
          "const": "unknown"
        },
        {
          "type": "string",
          "const": "succeeded"
        },
        {
          "type": "string",
          "const": "failed"
        },
        {
          "type": "string",
          "const": "not_found"
        }
      ]
    },
    "actual_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value",
        "subject"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "health": {
      "anyOf": [
        {
          "type": "string",
          "const": "healthy"
        },
        {
          "type": "string",
          "const": "unhealthy"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "core_path": {
      "anyOf": [
        {
          "type": "string",
          "const": "pass"
        },
        {
          "type": "string",
          "const": "fail"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "log_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "log_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value",
        "subject"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
