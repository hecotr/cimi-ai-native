{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DevOpsAdapterInput.v1",
  "type": "object",
  "required": [
    "schema_version",
    "operation_key",
    "operation",
    "environment_id",
    "release_id",
    "artifact_digest",
    "working_directory",
    "config_digest",
    "input_reference",
    "operation_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "anyOf": [
        {
          "type": "string",
          "const": "build"
        },
        {
          "type": "string",
          "const": "deploy"
        },
        {
          "type": "string",
          "const": "status"
        },
        {
          "type": "string",
          "const": "verify"
        },
        {
          "type": "string",
          "const": "recover"
        },
        {
          "type": "string",
          "const": "reconcile"
        }
      ]
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value",
        "subject"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "config_digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value",
        "subject"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "input_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
