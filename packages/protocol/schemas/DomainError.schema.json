{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "code",
    "message",
    "category",
    "retryable",
    "details",
    "correlation_id"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "anyOf": [
        {
          "type": "string",
          "const": "validation"
        },
        {
          "type": "string",
          "const": "not_found"
        },
        {
          "type": "string",
          "const": "conflict"
        },
        {
          "type": "string",
          "const": "forbidden"
        },
        {
          "type": "string",
          "const": "storage"
        },
        {
          "type": "string",
          "const": "internal"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "$id": "DomainError.v1",
  "additionalProperties": false
}
