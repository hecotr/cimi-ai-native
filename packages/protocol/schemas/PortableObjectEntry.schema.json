{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PortableObjectEntry.v1",
  "type": "object",
  "required": [
    "object_type",
    "schema_version",
    "id",
    "digest",
    "payload_reference",
    "payload"
  ],
  "properties": {
    "object_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "domain_version": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value",
        "subject"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "payload_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "payload": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  },
  "additionalProperties": false
}
