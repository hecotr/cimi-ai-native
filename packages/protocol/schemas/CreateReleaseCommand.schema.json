                },
                {
                  "type": "string",
                  "const": "feature_disable"
                },
                {
                  "type": "string",
                  "const": "traffic_shift"
                },
                {
                  "type": "string",
                  "const": "data_restore"
                },
                {
                  "type": "string",
                  "const": "compensation"
                },
                {
                  "type": "string",
                  "const": "manual"
                }
              ]
            },
            "target_digest": {
              "type": "object",
              "required": [
                "algorithm",
                "value",
                "subject"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "sha256"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            },
            "scope": {
              "type": "object",
              "required": [
                "in",
                "out"
              ],
              "properties": {
                "in": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "minItems": 1
                },
                "out": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "additionalProperties": false
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1
            },
            "verify_checks": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "digest"
                  },
                  {
                    "type": "string",
                    "const": "health"
                  },
                  {
                    "type": "string",
                    "const": "core_path"
                  }
                ]
              },
              "minItems": 1
            },
            "authorization": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "preauthorized"
                },
                {
                  "type": "string",
                  "const": "human_required"
                }
              ]
            }
          },
          "additionalProperties": false
        }
