{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DeploymentShowResult.v1",
  "type": "object",
  "required": [
    "ok",
    "deployment",
    "attempts"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
